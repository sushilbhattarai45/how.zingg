# Demo: everything on mocks + seeded USM data, zero external calls
DEMO_MODE=1
NEXT_PUBLIC_DEMO_MODE=1
DEMO_NOW=                       # optional ISO time; default 2027-07-14T14:02:00Z (Wed 9:02 AM CT)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Claude (set in Convex too: npx convex env set ANTHROPIC_API_KEY ...)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# Voice: Vapi (outbound phone + STT + LLM + TTS). Server-side only — set on Convex too:
#   npx convex env set VAPI_API_KEY ...
#   npx convex env set VAPI_PHONE_NUMBER_ID ...
#   npx convex env set CALL_ALLOWLIST +1yournumber
# Leave unset (or DEMO_MODE=1) to use the seeded Oak Hollow mock transcript.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=           # imported Twilio/Telnyx/Vonage number id from Vapi dashboard
CALL_ALLOWLIST=                 # comma-separated E.164 numbers, e.g. +16019132221
DEMO_CALL_TO=                   # required for My Places “Call” — only this number is dialed (never the realty)

# Legacy / stretch: ElevenLabs Agents + Twilio (unused by Caller now)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Google
GOOGLE_MAPS_API_KEY=
LIVE_PLACES=0
LIVE_ROUTES=0

# Web reading
FIRECRAWL_API_KEY=
LIVE_CRAWL=0

# Email
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
POSTMARK_INBOUND_SECRET=
